        "partitions": [
          {
            "name": "Fato_Votacao",
            "mode": "import",
            "state": "ready",
            "modifiedTime": "2026-10-24T21:31:10.786667",
            "refreshedTime": "2026-10-24T21:31:10.786667",
            "source": {
              "type": "m",
              "expression": "let\n    Fonte = Sql.Databases(\"25.35.69.146\"),\n    InnovationLab_AppliedBI = Fonte{[Name=\"InnovationLab_AppliedBI\"]}[Data],\n    dbo_Fato_Votacao = InnovationLab_AppliedBI{[Schema=\"dbo\",Item=\"Fato_Votacao\"]}[Data],\n    #\"Colunas Removidas\" = Table.RemoveColumns(dbo_Fato_Votacao,{\"Dim_Candidato_Partido\", \"Dim_Eleicao\", \"Dim_Local_Votacao\"})\nin\n    #\"Colunas Removidas\""
            }
          }
        ],
        "measures": [
          {
            "name": "Votos Alienados (Brancos e Nulos)",
            "expression": "CALCULATE(SUM(Fato_Votacao[QT_VOTOS]), REMOVEFILTERS(Dim_Candidato_Partido), Dim_Candidato_Partido[NK_CANDIDATO] IN {\"95\", \"96\"})",
            "formatString": "#,##0",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "a2087b5b-929d-464a-8e9c-6c1111325491",
            "dataType": "int64",
            "modifiedTime": "2026-10-26T18:44:25.78",
            "structureModifiedTime": "2026-10-26T18:33:45.75"
          },
          {
            "name": "Votos em Branco (95)",
            "expression": "CALCULATE(SUM(Fato_Votacao[QT_VOTOS]), REMOVEFILTERS(Dim_Candidato_Partido), Dim_Candidato_Partido[NK_CANDIDATO] = \"95\")",
            "formatString": "#,##0",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "8c74c322-52ff-4230-a2bb-1ee2257e175f",
            "dataType": "int64",
            "modifiedTime": "2026-10-26T18:44:25.78",
            "structureModifiedTime": "2026-10-26T18:33:45.753333"
          },
          {
            "name": "Votos Nulos (96)",
            "expression": "CALCULATE(SUM(Fato_Votacao[QT_VOTOS]), REMOVEFILTERS(Dim_Candidato_Partido), Dim_Candidato_Partido[NK_CANDIDATO] = \"96\")",
            "formatString": "#,##0",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "dbe26673-7201-4dd2-bf13-76df65ed761f",
            "dataType": "int64",
            "modifiedTime": "2026-10-26T18:44:25.78",
            "structureModifiedTime": "2026-10-26T18:33:45.753333"
          },
          {
            "name": "Votos Totais Cargo Urna",
            "expression": "CALCULATE(SUM(Fato_Votacao[QT_VOTOS]), REMOVEFILTERS(Dim_Candidato_Partido))",
            "formatString": "#,##0",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "d819f992-6144-4cc5-9cc3-ce2dd7edc25b",
            "dataType": "int64",
            "modifiedTime": "2026-10-26T18:44:25.78",
            "structureModifiedTime": "2026-10-26T18:33:45.753333"
          },
          {
            "name": "Votos Validos Cargo Urna",
            "expression": "CALCULATE(SUM(Fato_Votacao[QT_VOTOS]), REMOVEFILTERS(Dim_Candidato_Partido), NOT(Dim_Candidato_Partido[NK_CANDIDATO] IN {\"95\", \"96\", \"-1\"}))",
            "formatString": "#,##0",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "b7520cc4-58a0-4554-8d3b-424b72e905be",
            "dataType": "int64",
            "modifiedTime": "2026-10-26T18:44:25.78",
            "structureModifiedTime": "2026-10-26T18:33:45.753333"
          },
          {
            "name": "IAR 2018 (%)",
            "expression": "CALCULATE(DIVIDE([Votos Alienados (Brancos e Nulos)], [Votos Totais Cargo Urna], 0) * 100, Dim_Eleicao[NR_ANO] = 2018)",
            "formatString": "0.00\"%\"",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "270fc3c9-8d7d-4a8b-ae70-d3c096c7e604",
            "dataType": "double",
            "modifiedTime": "2026-10-26T18:44:25.78",
            "structureModifiedTime": "2026-10-26T18:33:45.753333"
          },
          {
            "name": "IAR 2022 (%)",
            "expression": "CALCULATE(DIVIDE([Votos Alienados (Brancos e Nulos)], [Votos Totais Cargo Urna], 0) * 100, Dim_Eleicao[NR_ANO] = 2022)",
            "formatString": "0.00\"%\"",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "fa5c223c-2009-4d25-b2cc-e9b8191ecaca",
            "dataType": "double",
            "modifiedTime": "2026-10-26T18:44:25.78",
            "structureModifiedTime": "2026-10-26T18:33:45.753333"
          },
          {
            "name": "KPI 09 - Delta IAR (p.p.)",
            "expression": "VAR vTot18 = CALCULATE([Votos Totais Cargo Urna], Dim_Eleicao[NR_ANO] = 2018) VAR vTot22 = CALCULATE([Votos Totais Cargo Urna], Dim_Eleicao[NR_ANO] = 2022) RETURN IF(vTot18 > 0 && vTot22 > 0, [IAR 2022 (%)] - [IAR 2018 (%)], BLANK())",
            "formatString": "+0.00\" p.p.\";-0.00\" p.p.\";0.00\" p.p.\"",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "f171253b-08cf-4050-913b-15c52ef0a916",
            "dataType": "double",
            "modifiedTime": "2026-10-26T19:00:59.373333",
            "structureModifiedTime": "2026-10-26T18:33:45.753333"
          },
          {
            "name": "KPI 09 - Qtd Locais Gatilho > 3 p.p.",
            "expression": "COALESCE(COUNTROWS(FILTER(VALUES(Dim_Local_Votacao[SK_LOCAL_VOTACAO]), Dim_Local_Votacao[SK_LOCAL_VOTACAO] > 0 && [KPI 09 - Delta IAR (p.p.)] > 3)), 0)",
            "formatString": "#,##0\" locais\"",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "064259b3-8830-44e9-a3fc-d3d8660357c6",
            "dataType": "int64",
            "modifiedTime": "2026-10-26T19:00:59.373333",
            "structureModifiedTime": "2026-10-26T18:33:45.753333"
          },
          {
            "name": "KPI 09 - Status Gatilho",
            "expression": "IF(ISBLANK([KPI 09 - Delta IAR (p.p.)]), BLANK(), IF([KPI 09 - Delta IAR (p.p.)] > 3, \"ALERTA (> +3 p.p.)\", IF([KPI 09 - Delta IAR (p.p.)] > 0, \"ATENCAO (0 a +3)\", \"QUEDA / ESTAVEL\")))",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "d4dcbe36-3bb1-4a8b-bd4c-b36bcc3f3f5c",
            "dataType": "string",
            "modifiedTime": "2026-10-26T19:00:59.373333",
            "structureModifiedTime": "2026-10-26T18:33:45.753333"
          },
          {
            "name": "Total Locais Analisados",
            "expression": "CALCULATE(DISTINCTCOUNT(Dim_Local_Votacao[SK_LOCAL_VOTACAO]), Dim_Local_Votacao[SK_LOCAL_VOTACAO] > 0)",
            "formatString": "#,##0",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "09056fa6-a50e-479c-a98d-b127bb6222e7",
            "dataType": "int64",
            "modifiedTime": "2026-10-26T18:44:25.78",
            "structureModifiedTime": "2026-10-26T18:33:45.753333"
          },
          {
            "name": "Votos Validos 2022",
            "expression": "CALCULATE([Votos Validos Cargo Urna], Dim_Eleicao[NR_ANO] = 2022)",
            "formatString": "#,##0",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "954ce1c8-1f6b-4efd-8569-a1c4502a6a2e",
            "dataType": "int64",
            "modifiedTime": "2026-10-26T19:18:38.806667",
            "structureModifiedTime": "2026-10-26T19:00:59.366667"
          },
          {
            "name": "Votos Alienados 2022",
            "expression": "CALCULATE([Votos Alienados (Brancos e Nulos)], Dim_Eleicao[NR_ANO] = 2022)",
            "formatString": "#,##0",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "f9d4bfbc-4448-4386-b833-9d9ba8856afd",
            "dataType": "int64",
            "modifiedTime": "2026-10-26T19:18:38.806667",
            "structureModifiedTime": "2026-10-26T19:00:59.366667"
          },
          {
            "name": "Votos Alienados 2018",
            "expression": "CALCULATE([Votos Alienados (Brancos e Nulos)], Dim_Eleicao[NR_ANO] = 2018)",
            "formatString": "#,##0",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "fde18116-a7a0-44fc-ace9-219b785ba060",
            "dataType": "int64",
            "modifiedTime": "2026-10-26T19:18:38.806667",
            "structureModifiedTime": "2026-10-26T19:00:59.366667"
          },
          {
            "name": "Votos em Branco 2022 (95)",
            "expression": "CALCULATE([Votos em Branco (95)], Dim_Eleicao[NR_ANO] = 2022)",
            "formatString": "#,##0",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "8f5535fc-e291-4489-81ec-5c5c2e881ac9",
            "dataType": "int64",
            "modifiedTime": "2026-10-26T19:18:38.806667",
            "structureModifiedTime": "2026-10-26T19:00:59.366667"
          },
          {
            "name": "Votos Nulos 2022 (96)",
            "expression": "CALCULATE([Votos Nulos (96)], Dim_Eleicao[NR_ANO] = 2022)",
            "formatString": "#,##0",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "98d00454-6fc7-4eb8-8b52-e031b0a27c31",
            "dataType": "int64",
            "modifiedTime": "2026-10-26T19:18:38.806667",
            "structureModifiedTime": "2026-10-26T19:00:59.366667"
          },
          {
            "name": "IAR Taxa Alienacao (%)",
            "expression": "DIVIDE([Votos Alienados (Brancos e Nulos)], [Votos Totais Cargo Urna], 0) * 100",
            "formatString": "0.00\"%\"",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "1db083b7-7115-4f30-8e78-28ee04faf2fe",
            "dataType": "double",
            "modifiedTime": "2026-10-26T19:18:38.806667",
            "structureModifiedTime": "2026-10-26T19:00:59.366667"
          },
          {
            "name": "KPI 09 - Delta IAR Santo Andre",
            "expression": "CALCULATE([KPI 09 - Delta IAR (p.p.)], CONTAINSSTRING(Dim_Local_Votacao[NM_MUNICIPIO], \"SANTO ANDR\"))",
            "formatString": "+0.00\" p.p.\";-0.00\" p.p.\";0.00\" p.p.\"",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "0df9c95e-6aa8-438b-8689-45e4c277fe9a",
            "dataType": "double",
            "modifiedTime": "2026-10-26T19:27:53.16",
            "structureModifiedTime": "2026-10-26T19:00:59.366667"
          },
          {
            "name": "Locais Forte Queda (< -5 p.p.)",
            "expression": "COALESCE(COUNTROWS(FILTER(VALUES(Dim_Local_Votacao[SK_LOCAL_VOTACAO]), Dim_Local_Votacao[SK_LOCAL_VOTACAO] > 0 && NOT(ISBLANK([KPI 09 - Delta IAR (p.p.)])) && [KPI 09 - Delta IAR (p.p.)] <= -5)), 0)",
            "formatString": "#,##0",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "ed448db4-a9ac-4e32-bce4-47658b064083",
            "dataType": "int64",
            "modifiedTime": "2026-10-26T19:18:38.806667",
            "structureModifiedTime": "2026-10-26T19:00:59.366667"
          },
          {
            "name": "Locais Queda Moderada (-5 a 0 p.p.)",
            "expression": "COALESCE(COUNTROWS(FILTER(VALUES(Dim_Local_Votacao[SK_LOCAL_VOTACAO]), Dim_Local_Votacao[SK_LOCAL_VOTACAO] > 0 && [KPI 09 - Delta IAR (p.p.)] > -5 && [KPI 09 - Delta IAR (p.p.)] <= 0)), 0)",
            "formatString": "#,##0",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "9cdc2c1a-9206-4a37-b7a5-d80886b484dd",
            "dataType": "int64",
            "modifiedTime": "2026-10-26T19:18:38.806667",
            "structureModifiedTime": "2026-10-26T19:00:59.366667"
          },
          {
            "name": "Locais Aumento Moderado (0 a +3 p.p.)",
            "expression": "COALESCE(COUNTROWS(FILTER(VALUES(Dim_Local_Votacao[SK_LOCAL_VOTACAO]), Dim_Local_Votacao[SK_LOCAL_VOTACAO] > 0 && [KPI 09 - Delta IAR (p.p.)] > 0 && [KPI 09 - Delta IAR (p.p.)] <= 3)), 0)",
            "formatString": "#,##0",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "d91f72cd-3c8c-4576-8494-fdc52b8caa71",
            "dataType": "int64",
            "modifiedTime": "2026-10-26T19:18:38.806667",
            "structureModifiedTime": "2026-10-26T19:00:59.366667"
          },
          {
            "name": "Subtitulo Card 1 (Variacao Votos Alienados)",
            "expression": "VAR vDiff = [Votos Alienados 2022] - [Votos Alienados 2018] VAR vSinal = IF(vDiff <= 0, UNICHAR(9660) & \" \", UNICHAR(9650) & \" +\") RETURN vSinal & FORMAT(vDiff, \"#,##0\") & \" votos alienados (2022 vs 2018)\"",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "5c8b2695-c919-4d5a-b1ac-fb7210da4927",
            "dataType": "string",
            "modifiedTime": "2026-10-30T19:03:51.07",
            "structureModifiedTime": "2026-10-30T18:55:48.39"
          },
          {
            "name": "Subtitulo Card 4 (Volume 2022)",
            "expression": "UNICHAR(9660) & \" \" & FORMAT([Votos Alienados 2022], \"#,##0\") & \" Votos Alienados no 1\" & UNICHAR(186) & \" Turno (2022)\"",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "1a76b157-81b0-4425-8ee4-6b3a824eef64",
            "dataType": "string",
            "modifiedTime": "2026-10-30T19:03:51.07",
            "structureModifiedTime": "2026-10-30T18:55:48.39"
          },
          {
            "name": "Subtitulo Card 5 (Volume 2018)",
            "expression": "UNICHAR(9679) & \" \" & FORMAT([Votos Alienados 2018], \"#,##0\") & \" Votos Alienados no 1\" & UNICHAR(186) & \" Turno (2018)\"",
            "displayFolder": "KPI 09 - Alienacao Eleitoral",
            "lineageTag": "73ea2714-f09e-40b5-9a4e-39fca981ff0d",
            "dataType": "string",
            "modifiedTime": "2026-10-30T19:03:51.07",
            "structureModifiedTime": "2026-10-30T18:55:48.39"
          }
        ],
